# Copy to .env. Every value has a placeholder default; nothing here is required to run locally.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://carenest@127.0.0.1:54329/carenest
SECRET_KEY=change-me-to-a-long-random-string
RUN_WORKER=true
RUN_MIGRATIONS_ON_STARTUP=false
DB_NULL_POOL=false
NURSE_SMS_ENABLED=true

# Placeholders until the client's domain is known
DOMAIN=carenest.example
API_BASE_URL=http://localhost:8000
ADMIN_BASE_URL=http://localhost:5173
APP_ID=example.carenest
EMAIL_FROM=noreply@carenest.example
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-please
ADMIN_NOTIFY_EMAIL=admin@example.com

# SMS (MSG91). Empty key = codes are logged, nothing is sent.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CRNEST
MSG91_OTP_TEMPLATE_ID=
# visit_new=<id>,visit_removed=<id>,visit_cancelled=<id>,booking_confirmed=<id>,nurse_changed=<id>,booking_cancelled=<id>
MSG91_TEMPLATE_IDS=
SMS_WHITELIST=

# Email (Brevo). Empty key = emails are logged.
BREVO_API_KEY=

# Payments: fake until Razorpay keys exist
PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_MAPS_API_KEY=

# Nightly backup to Backblaze B2
B2_ENDPOINT=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
BACKUP_ENCRYPTION_KEY=
